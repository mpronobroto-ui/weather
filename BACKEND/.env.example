# Copy this file to ".env" (same folder as main.py) and fill in what you
# have. main.py loads this automatically on startup — no need to set
# environment variables by hand in every terminal session.
# Every section below is OPTIONAL — the app runs fully without any of them,
# just with fewer live integrations turned on.


# ---- Runtime / CORS ---------------------------------------------------------
# Use development locally. On Render set production and allow only your real
# frontend origin(s), comma-separated.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,null

# ---- LLM query understanding + phrasing (pick ONE) -------------------------
GEMINI_API_KEY=paste_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=sk-...
# OLLAMA_URL=http://localhost:11434

# ---- WIS2.0 live MQTT ingestion (Global Broker, no key needed) -------------
WIS2_ENABLE=true
WIS2_BROKER_HOST=globalbroker.meteo.fr
WIS2_BROKER_PORT=8883
WIS2_USERNAME=everyone
WIS2_PASSWORD=everyone
WIS2_TOPIC=cache/a/wis2/+/data/core/weather/prediction/forecast/cyclone_tracks

# ---- PostgreSQL/PostGIS district-boundary lookup (GIS layer) --------------
# Requires PostgreSQL 13+ with the PostGIS extension enabled.
# Either set DATABASE_URL (Render/Heroku-style connection string)...
# DATABASE_URL=postgresql://user:password@host:5432/weathergpt
# ...or the individual PG_* vars below (used if DATABASE_URL is unset):
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_DB=weathergpt

# ---- Google Custom Search (general-question fallback + LLM grounding) -----
# From https://programmablesearchengine.google.com (Search Engine ID) and
# https://console.cloud.google.com (API key, with Custom Search API enabled).
# Optional — unlocks: (1) live web-search grounding folded into LLM answers,
# and (2) a sourced fallback answer for off-topic questions when no LLM key
# is configured at all.
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_CSE_ID=your_search_engine_id_here

# ---- SMS early-warning dissemination (Twilio) ------------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+15551234567
ALERT_DISPATCH_MIN_LEVEL=orange
ALERT_DISPATCH_INTERVAL_SECONDS=3600
# Radius (km) from a subscriber's saved point within which an active
# cyclone triggers an SMS. Default 100km.
CYCLONE_ALERT_RADIUS_KM=100
# Shared secret required (as an X-Dispatch-Secret header) to call
# POST /api/alerts/dispatch. That endpoint triggers real SMS sends to every
# subscriber, so leaving it unset means anyone who finds the URL can trigger
# (and repeatedly re-trigger) real SMS spend. Unset = endpoint stays open,
# with a warning logged at startup — fine for local dev, not for a real
# deployment.
ALERT_DISPATCH_SECRET=change-me-to-a-long-random-string

# ---- Login (phone + OTP) ----------------------------------------------------
# Signs session tokens issued after OTP verification. CHANGE THIS in any
# real deployment — leaving the default lets anyone forge a session token.
SESSION_SECRET=change-me-to-a-long-random-string
OTP_TTL_SECONDS=300
SESSION_TTL_SECONDS=2592000
